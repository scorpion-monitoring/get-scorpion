---
// Footer (docs/plan.md §2, section 8): logo, docs, GitHub, contact and the release line.
import logoDark from '../assets/logos/scorpion-dark.png';
import logoLight from '../assets/logos/scorpion-light.png';
import { getLink } from '../lib/data';
import { getRelease } from '../lib/generated';
import { t } from '../lib/i18n';
import { m } from '../paraglide/messages.js';
import type { Locale } from '../paraglide/runtime.js';
import GitHubMark from './GitHubMark.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const options = { locale };
const docs = await getLink('docs');
const github = await getLink('github');
const contact = await getLink('contact');
const releases = await getLink('releases');
const release = getRelease();

const linkClass =
  'inline-flex min-h-6 items-center gap-2 py-1 underline underline-offset-4 hover:decoration-2';
---

<footer class="mt-12 border-t border-base-300 bg-base-200">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-4 pt-10 pb-4 md:flex-row md:items-center md:justify-between">
    <Logo
      src={logoLight}
      dark={logoDark}
      alt={m.logo_alt_scorpion({}, options)}
      width={180}
      height={60}
      name="Scorpion"
    />
    <nav aria-label={m.footer_label({}, options)}>
      <ul class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-x-6">
        <li>
          <a href={docs.url} class={linkClass}>
            {t(docs.label, locale)}
          </a>
        </li>
        <li>
          <a href={github.url} class={linkClass}>
            <GitHubMark size={18} />
            {t(github.label, locale)}
          </a>
        </li>
        <li>
          <a href={contact.url} class={linkClass}>
            <Icon name="message-circle" size={18} />
            {m.footer_contact({}, options)}
          </a>
        </li>
        {/* M6: IPK imprint and privacy links, per locale (docs/plan.md §1, §12.5). */}
      </ul>
    </nav>
  </div>
  <div class="mx-auto max-w-5xl px-4 pb-10">
    <a href={`${releases.url}/tag/${release.tag}`} class={linkClass}>
      {m.footer_release({ version: release.tag }, options)}
    </a>
  </div>
</footer>
