---
// An image that switches to its dark variant, if there is one, through `prefers-color-scheme` in a
// hand-written <picture> (docs/plan.md §6). Raster images are optimised by astro:assets (sharp) to
// WebP at 1× and 2× (a 2× variant is capped at the source size, never upscaled); SVGs are emitted
// as files. Each image is fitted into the `width` × `height` box, keeping its aspect ratio, and
// gets fixed width and height attributes. No inline styles, so the page keeps `style-src 'self'`.
//
// Used by Logo (logos), Features (screenshots) and the OpenSSF badges.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata | undefined;
  alt: string;
  /** The box the image is fitted into, in CSS pixels. */
  width: number;
  height: number;
  loading?: 'eager' | 'lazy';
  /** Classes of the <picture>; `inline-block shrink-0` by default. */
  class?: string;
  /** Classes of the <img>, for example `h-auto w-full` to let it shrink with its container. */
  imgClass?: string;
}

const {
  src,
  dark,
  alt,
  width,
  height,
  loading = 'lazy',
  class: className = 'inline-block shrink-0',
  imgClass,
} = Astro.props;

async function optimise(image: ImageMetadata) {
  const scale = Math.min(width / image.width, height / image.height);
  const size = {
    width: Math.round(image.width * scale),
    height: Math.round(image.height * scale),
  };
  if (image.format === 'svg') {
    const result = await getImage({ src: image, ...size, format: 'svg' });
    return { ...size, src: result.src, srcset: result.src, type: 'image/svg+xml' };
  }
  const result = await getImage({ src: image, ...size, densities: [1, 2], format: 'webp' });
  return { ...size, src: result.src, srcset: result.srcSet.attribute, type: 'image/webp' };
}

const light = await optimise(src);
const darkImage = dark ? await optimise(dark) : undefined;
---

<picture class={className}>
  {darkImage && (
    <source
      media="(prefers-color-scheme: dark)"
      srcset={darkImage.srcset}
      type={darkImage.type}
      width={darkImage.width}
      height={darkImage.height}
    />
  )}
  <img
    src={light.src}
    srcset={light.srcset === light.src ? undefined : light.srcset}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={loading}
    decoding="async"
    class={imgClass}
  />
</picture>
