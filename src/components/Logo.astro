---
// A logo in a fixed box. With an image, it is a ThemedPicture: optimised by astro:assets and
// switching to the dark variant, if there is one, through `prefers-color-scheme`.
// Without an image (organisation logos until permission is recorded in ASSETS.md), it renders a
// neutral placeholder: the organisation name in a bordered box at the same size, with the same
// alt text. Swapping in the real logo is then a change to the YAML data only.
//
// No inline styles: the placeholder takes its size from an SVG's width and height attributes, so
// the page keeps `style-src 'self'` (docs/plan.md §6).
import type { ImageMetadata } from 'astro';
import ThemedPicture from './ThemedPicture.astro';

interface Props {
  src?: ImageMetadata | undefined;
  dark?: ImageMetadata | undefined;
  alt: string;
  /** The box the logo is fitted into, in CSS pixels. */
  width: number;
  height: number;
  /** Shown in the placeholder. */
  name: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, dark, alt, width, height, name, loading = 'lazy', class: className } = Astro.props;
---

{src ? (
  <ThemedPicture
    src={src}
    dark={dark}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    class:list={['inline-block shrink-0', className]}
  />
) : (
  <span
    role="img"
    aria-label={alt}
    class:list={['relative inline-block shrink-0 text-base-content', className]}
    data-logo-placeholder
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      aria-hidden="true"
      focusable="false"
      class="block"
    >
      <rect
        x="0.5"
        y="0.5"
        width={width - 1}
        height={height - 1}
        rx="6"
        fill="none"
        stroke="currentColor"
        stroke-dasharray="4 3"
      />
    </svg>
    <span class="absolute inset-0 flex items-center justify-center p-2 text-center text-sm leading-tight font-semibold">
      {name}
    </span>
  </span>
)}
