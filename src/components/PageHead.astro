---
// The <head> metadata of a page in one locale (docs/plan.md §7): title and description, the
// canonical URL, hreflang alternates for every locale and x-default, Open Graph tags (read by
// LinkedIn, Mastodon, Slack and others) and the favicon. No Twitter/X tags (decision of
// 2026-11-20). Every URL is absolute on `site`; every text comes from messages/ through the caller.
//
// The Open Graph images are committed PNGs in public/og/, made by `pnpm og-images`
// (scripts/og-images.mjs), so they are served from our own origin.
import { m } from '../paraglide/messages.js';
import { baseLocale, locales, type Locale } from '../paraglide/runtime.js';
import { OG_LOCALE, pageUrl, type PageId } from '../lib/pages';

interface Props {
  locale: Locale;
  page: PageId;
  title: string;
  description: string;
  /** Defaults to `title` and `description`. */
  ogTitle?: string;
  ogDescription?: string;
}

const {
  locale,
  page,
  title,
  description,
  ogTitle = title,
  ogDescription = description,
} = Astro.props;
const options = { locale };
const site = Astro.site;
const canonical = pageUrl(page, locale, site);
const ogImage = new URL(`/og/${locale}.png`, site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{locales.map((l) => (
  <link rel="alternate" hreflang={l} href={pageUrl(page, l, site)} />
))}
<link rel="alternate" hreflang="x-default" href={pageUrl(page, baseLocale, site)} />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={m.site_name({}, options)} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={m.og_image_alt({}, options)} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{locales
  .filter((l) => l !== locale)
  .map((l) => (
    <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
  ))}
