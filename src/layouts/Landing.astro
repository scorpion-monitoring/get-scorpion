---
// The landing page with the sections in the order of docs/plan.md §2, its head metadata (§7), the
// Bioschemas structured data, and a link to events.jsonld, the Bioschemas markup of the upcoming
// events that TeSS harvests (§4).
import Events from '../components/Events.astro';
import Features from '../components/Features.astro';
import Funding from '../components/Funding.astro';
import GetStarted from '../components/GetStarted.astro';
import Hero from '../components/Hero.astro';
import Instances from '../components/Instances.astro';
import StructuredData from '../components/StructuredData.astro';
import { m } from '../paraglide/messages.js';
import type { Locale } from '../paraglide/runtime.js';
import Page from './Page.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const options = { locale };
---

<Page
  locale={locale}
  page="home"
  title={m.page_title({}, options)}
  description={m.meta_description({}, options)}
  ogTitle={m.og_title({}, options)}
  ogDescription={m.og_description({}, options)}
>
  <StructuredData slot="head" locale={locale} />
  <link
    slot="head"
    rel="alternate"
    type="application/ld+json"
    href="/events/events.jsonld"
    title={m.events_jsonld_title({}, options)}
  />
  <Hero locale={locale} />
  <GetStarted locale={locale} />
  <Events locale={locale} />
  <Instances locale={locale} />
  <Features locale={locale} />
  <Funding locale={locale} />
</Page>
