---
// The shell of every page: <head> metadata (PageHead), skip link, nav, <main> and footer. The
// landing page (Landing.astro) fills <main>; the named slot
// `head` takes extra head elements, such as the structured data. Every page loads the Matomo
// tracker (src/scripts/matomo.ts, docs/plan.md §6).
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import PageHead from '../components/PageHead.astro';
import type { PageId } from '../lib/pages';
import { m } from '../paraglide/messages.js';
import type { Locale } from '../paraglide/runtime.js';
import '../styles/app.css';

interface Props {
  locale: Locale;
  page: PageId;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { locale, page } = Astro.props;
const options = { locale };
---

<!doctype html>
<html lang={locale}>
  <head>
    <PageHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-box focus:bg-base-100 focus:px-4 focus:py-2"
    >
      {m.skip_to_content({}, options)}
    </a>
    <Nav locale={locale} page={page} />
    <main id="main" tabindex="-1" class="mx-auto max-w-5xl px-4">
      <slot />
    </main>
    <Footer locale={locale} />
    <script src="../scripts/matomo.ts"></script>
  </body>
</html>
