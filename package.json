{
  "name": "get-scorpion",
  "private": true,
  "type": "module",
  "description": "Public landing page of Scorpion at https://scorpion.bi.denbi.de/",
  "license": "ISC",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "fetch-docs-export": "node scripts/fetch-docs-export.mjs",
    "bump-release": "node scripts/bump-release.mjs",
    "events:check": "node scripts/build-events.mjs --check",
    "events:build": "node scripts/build-events.mjs",
    "og-images": "node scripts/og-images.mjs",
    "dev": "node scripts/fetch-docs-export.mjs && astro dev",
    "build": "node scripts/fetch-docs-export.mjs && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "node scripts/check-messages.mjs && astro check",
    "check:html": "node scripts/check-html.mjs",
    "check:links": "lychee --offline --include-fragments --root-dir dist --index-files index.html --no-progress dist",
    "check:links:online": "lychee --no-progress 'src/data/*.yaml'",
    "check:browser": "node --test --test-reporter=spec scripts/check-browser.mjs",
    "check:theme-drift": "node scripts/check-theme-drift.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "ajv": "^8.20.0",
    "astro": "^7.4.12",
    "axe-core": "^4.14.0",
    "daisyui": "^5.8.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "opentype.js": "^2.0.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  }
}
